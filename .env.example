# ---------------------------------------------------------------
# AUX JOLIS PAS — variables d'environnement
# Copier ce fichier en .env.local (développement) ou les déclarer
# chez l'hébergeur (production). NE JAMAIS committer de vraies clés.
# Les variables préfixées NEXT_PUBLIC_ sont visibles côté navigateur :
# n'y placez jamais de secret.
# ---------------------------------------------------------------

# URL publique du site (sans slash final) — utilisée pour le SEO, Stripe et les e-mails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : SERVEUR UNIQUEMENT (webhooks, création de commandes, journaux)
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Dashboard > Développeurs > Clés API) ---
STRIPE_SECRET_KEY=
# Secret de signature du webhook (Dashboard > Développeurs > Webhooks, ou `stripe listen`)
STRIPE_WEBHOOK_SECRET=

# --- Google Places API (avis Google) — facultatif ---
# Clé restreinte à "Places API (New)" et, idéalement, aux IP du serveur
GOOGLE_PLACES_API_KEY=
# Identifiant de la fiche (Place ID) du magasin
GOOGLE_PLACE_ID=

# --- Mesure d'audience / marketing — chargés UNIQUEMENT après consentement ---
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Anti-spam du formulaire de contact (Cloudflare Turnstile) — facultatif ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- E-mails transactionnels (Resend) — facultatif ---
RESEND_API_KEY=
EMAIL_FROM="Aux Jolis Pas <boutique@votre-domaine.fr>"
# Adresse qui reçoit les messages du formulaire de contact et les nouvelles commandes
STORE_NOTIFICATION_EMAIL=

# Sel utilisé pour hacher les adresses IP (anti-spam, journal de consentement)
IP_HASH_SALT=change-me-to-a-long-random-string

# --- Administrateur initial ---
# Le compte créé sur le site avec CET e-mail (une fois confirmé) devient administrateur à sa 1re connexion.
ADMIN_EMAIL=

# --- Base PostgreSQL (fournie automatiquement par l'intégration Supabase de Vercel) ---
# Sert uniquement à appliquer les migrations SQL au moment du build (scripts/migrate.mjs).
POSTGRES_URL_NON_POOLING=

# --- Tâche planifiée (remise en vente des réservations expirées, chaque matin) ---
# Chaîne aléatoire longue ; Vercel l'envoie automatiquement à /api/cron/reservations
CRON_SECRET=
